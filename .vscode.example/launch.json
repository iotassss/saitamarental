{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Package",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${fileDirname}",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Attach to Docker",
            "type": "go",
            "request": "attach",
            "mode": "remote",
            "port": 2345,
            "host": "localhost",
            "apiVersion": 2,
            "showLog": true
        },
        {
            "name": "Launch Test with Delve",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/internal/usecase", // テスト対象のパッケージディレクトリを指定
            "env": {},
            "args": [
                "-test.v",
                "-test.run",
                "TestSeedCitiesInteractor_Execute_Valid" // 実行するテスト関数
            ]
        }
    ]
}
